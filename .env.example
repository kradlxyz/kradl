# ===========================================
# Kradl — Environment Configuration Example
# ===========================================

# Database (PostgreSQL 16 via Docker)
DATABASE_URL="postgresql://kradl:kradl_dev_password@localhost:5432/kradl?schema=public"
POSTGRES_USER="kradl"
POSTGRES_PASSWORD="kradl_dev_password"
POSTGRES_DB="kradl"

# Auth (SIWE JWT Secret — ganti dengan random 32+ char di production)
JWT_SECRET="replace-with-secure-random-string-min-32-chars"

# Smart Contract Deployment (JANGAN pernah commit private key asli!)
DEPLOYER_PRIVATE_KEY=""

# RPC Endpoints
ROBINHOOD_TESTNET_RPC_URL="https://rpc.testnet.chain.robinhood.com"
ROBINHOOD_MAINNET_RPC_URL="https://rpc.mainnet.chain.robinhood.com"
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
BASE_MAINNET_RPC_URL="https://mainnet.base.org"

# Frontend Public Config
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
NEXT_PUBLIC_DEFAULT_CHAIN_ID="46630"
